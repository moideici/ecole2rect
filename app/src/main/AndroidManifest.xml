<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".Ecole2recteApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ecole2recte">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ecole2recte" android:host="notes" />
                <data android:scheme="ecole2recte" android:host="agenda" />
                <data android:scheme="ecole2recte" android:host="devoirs" />
                <data android:scheme="ecole2recte" android:host="messages" />
            </intent-filter>
        </activity>

        <activity android:name=".widget.WidgetConfigurationActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <receiver android:name=".widget.MeanWidgetReceiver" android:exported="true" android:label="@string/widget_mean_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/mean_widget_info" />
        </receiver>
        <receiver android:name=".widget.SmallNextClassWidgetReceiver" android:exported="true" android:label="@string/widget_small_next_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/small_next_class_widget_info" />
        </receiver>
        <receiver android:name=".widget.RemainingHomeworkWidgetReceiver" android:exported="true" android:label="@string/widget_small_homework_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/remaining_homework_widget_info" />
        </receiver>
        <receiver android:name=".widget.LastGradeWidgetReceiver" android:exported="true" android:label="@string/widget_small_grade_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/last_grade_widget_info" />
        </receiver>
        <receiver android:name=".widget.UnreadMessagesWidgetReceiver" android:exported="true" android:label="@string/widget_small_messages_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/unread_messages_widget_info" />
        </receiver>
        <receiver android:name=".widget.ExamCountdownWidgetReceiver" android:exported="true" android:label="@string/widget_small_exam_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/exam_countdown_widget_info" />
        </receiver>
        <receiver android:name=".widget.GoalsWidgetReceiver" android:exported="true" android:label="@string/widget_goals_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/goals_widget_info" />
        </receiver>
        <service android:name=".widget.MeanTileService" android:exported="true"
            android:label="@string/tile_mean_label" android:icon="@drawable/ic_tile_mean"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".sync.NextClassTileService"
            android:exported="true" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:icon="@drawable/ic_stat_ecole2recte" android:label="Prochain cours">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".widget.SchoolLifeWidgetReceiver" android:exported="true" android:label="Vie scolaire">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/school_life_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.NextClassWidgetReceiver"
            android:exported="true"
            android:label="@string/sync_widget_next_class_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_class_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.DayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.HomeworkWidgetReceiver"
            android:exported="true"
            android:label="@string/sync_widget_homework_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/homework_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.GradesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_grades_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grades_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.MessagesWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_messages_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/messages_widget_info" />
        </receiver>
    </application>
</manifest>
