        <receiver
            android:name=".widget.SubjectAveragesWidget"
            android:exported="false"
            android:label="@string/widget_subject_averages_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_subject_averages" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidget"
            android:exported="false"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week" />
        </receiver>
    </application>
</manifest>
