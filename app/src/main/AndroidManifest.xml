<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Demandée à l'exécution, et seulement quand l'utilisateur active les notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".Ecole2recteApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="ecole2recte"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ecole2recte">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="ecole2recte"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>


        <!-- Réglages d'un widget « moyenne » au moment où on le pose. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="Réglages du widget"
            android:theme="@style/Theme.Ecole2recte">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Partage des pièces jointes téléchargées avec l'application qui saura les ouvrir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Seize widgets d'écran d'accueil : six tuiles 1×1, cinq bandeaux 2×1,
             quatre listes 2×2 et une semaine 4×2. Chacun lit le cache local, sans réseau. -->
        <receiver
            android:name=".widget.NextLessonWidget"
            android:exported="false"
            android:label="@string/widget_next_lesson_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_lesson" />
        </receiver>

        <receiver
            android:name=".widget.DayWidget"
            android:exported="false"
            android:label="@string/widget_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_day" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidget"
            android:exported="false"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week" />
        </receiver>

        <receiver
            android:name=".widget.HomeworkWidget"
            android:exported="false"
            android:label="@string/widget_homework_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_homework" />
        </receiver>

        <receiver
            android:name=".widget.GradesWidget"
            android:exported="false"
            android:label="@string/widget_grades_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_grades" />
        </receiver>

        <receiver
            android:name=".widget.ObjectiveWidget"
            android:exported="false"
            android:label="@string/widget_objective_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_objective" />
        </receiver>

        <receiver
            android:name=".widget.SchoolLifeWidget"
            android:exported="false"
            android:label="@string/widget_school_life_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_school_life" />
        </receiver>

        <receiver
            android:name=".widget.ChangesWidget"
            android:exported="false"
            android:label="@string/widget_changes_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_changes" />
        </receiver>

        <receiver
            android:name=".widget.TomorrowWidget"
            android:exported="false"
            android:label="@string/widget_tomorrow_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tomorrow" />
        </receiver>
    </application>
</manifest>
