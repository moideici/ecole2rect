            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unread" />
        </receiver>

        <receiver
            android:name=".widget.CountdownWidget"
            android:exported="false"
            android:label="@string/widget_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_countdown" />
        </receiver>

        <receiver
            android:name=".widget.RoomWidget"
            android:exported="false"
            android:label="@string/widget_room_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_room" />
        </receiver>

        <receiver
            android:name=".widget.SyncWidget"
            android:exported="false"
            android:label="@string/widget_sync_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sync" />
        </receiver>

        <receiver
