            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- L'avancement du cours en cours : la seule chose qu'un emploi du temps montre mieux
         qu'une phrase. Masquée quand aucun cours n'est commencé. -->
