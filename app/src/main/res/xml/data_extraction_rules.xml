<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne quitte l'appareil : ni sauvegarde cloud, ni transfert vers un autre téléphone.
     Les identifiants sont chiffrés par une clé du Keystore, qui ne serait de toute façon
     pas restaurable ailleurs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
